From b8a8881a3ad0af9a07deccc4112c464bd0362519 Mon Sep 17 00:00:00 2001
From: Reuben Horner <reubarb.scons@gmail.com>
Date: Thu, 22 Oct 2026 11:17:31 +1300
Subject: [PATCH] Wait for the default route before reporting the network state

connman's services are loaded after start-up, so the first report went
out before the default route was known and described the connection as
metered mobile data. Qualcomm's XTRA client gives up on a download
attempted then. Skip the report until the route is known (the
defaultRouteChanged signal triggers it), and only report changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Bjcm5NyXPk9Dun3FP3X9LN
---
 hybrisprovider.cpp | 15 +++++++++++++--
 hybrisprovider.h   |  1 +
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/hybrisprovider.cpp b/hybrisprovider.cpp
index 681b713..ca74eef 100644
--- a/hybrisprovider.cpp
+++ b/hybrisprovider.cpp
@@ -931,11 +931,22 @@ void HybrisProvider::updateNetworkState()
     const NetworkManager::State state = m_networkManager->globalState();
     const bool connected = state == NetworkManager::OnlineState || state == NetworkManager::ReadyState;
     NetworkService *service = m_networkManager->defaultRoute();
-    const bool unmetered = service && service->type() != QLatin1String("cellular");
+
+    // connman's services are loaded after start-up: until the default route
+    // is known so is the connection type, so wait for defaultRouteChanged
+    // rather than report the connection as metered meanwhile
+    if (connected && !service)
+        return;
+
+    const bool unmetered = connected && service->type() != QLatin1String("cellular");
+    const int reported = (connected ? 1 : 0) | (unmetered ? 2 : 0);
+    if (reported == m_reportedNetworkState)
+        return;
+    m_reportedNetworkState = reported;
 
     qCDebug(lcGeoclueHybris) << "Network" << (connected ? "connected" : "not connected")
                              << (unmetered ? "unmetered" : "metered");
-    m_backend->aGnssRilUpdateNetworkState(connected, connected && unmetered);
+    m_backend->aGnssRilUpdateNetworkState(connected, unmetered);
 }
 
 void HybrisProvider::defaultDataModemChanged(const QString &modem)
diff --git a/hybrisprovider.h b/hybrisprovider.h
index 9ff0609..021e8ef 100644
--- a/hybrisprovider.h
+++ b/hybrisprovider.h
@@ -195,6 +195,7 @@ private:
     QMap<QString, ServiceData> m_watchedServices;
 
     QBasicTimer m_idleTimer;
+    int m_reportedNetworkState = -1;
     QBasicTimer m_fixLostTimer;
 
     Status m_status;
